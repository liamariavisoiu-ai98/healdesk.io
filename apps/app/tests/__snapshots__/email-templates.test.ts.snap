exports[`each template's output > agreement_question, for clients: the snapshot 1`] = `
{
  "html": "<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>A quick question about your healdesk agreement</title>
<style>@media (prefers-color-scheme: dark) {
  body, .hd-wrap { background: #0d1117 !important; color: #e6edf3 !important; }
  .hd-muted { color: #9da7b3 !important; }
  a { color: #8cc4ff !important; }
  a.hd-action { background: #e6edf3 !important; color: #0d1117 !important; }
}</style>
</head>
<body style="margin:0;padding:0;background:#ffffff;color:#1f2328;">
<span style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">One word back from you: Yes, No or Not sure.</span>
<div class="hd-wrap" style="max-width:560px;margin:0 auto;padding:24px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#1f2328;background:#ffffff;">
<p style="margin:0 0 16px;">Hi Radiance Med Spa team, when you signed up you told us your practice doesn&#39;t bill insurance electronically, so you signed our Data Protection Agreement. Your website mentions accepting insurance. That can be fine (superbills, or being out of network).</p>
<p style="margin:0 0 16px;">If your practice sends insurance claims or eligibility checks electronically, though, you need our business associate agreement instead.</p>
<p style="margin:0 0 16px;">Could you reply with one word: Yes, No or Not sure?</p>
<p style="margin:0 0 16px;">If it&#39;s Yes or Not sure, we&#39;ll send the business associate agreement to sign, and AYA pauses until it&#39;s signed. If it&#39;s No, nothing changes.</p>
<hr style="border:none;border-top:1px solid #d0d7de;margin:24px 0 16px;">
<p class="hd-muted" style="margin:0 0 6px;color:#57606a;font-size:13px;">You&#39;re receiving this because this is the address on Radiance Med Spa&#39;s healdesk account.</p>
<p class="hd-muted" style="margin:0 0 6px;color:#57606a;font-size:13px;">Replies reach the healdesk team. Please leave out your clients&#39; details.</p>
<p class="hd-muted" style="margin:0 0 6px;color:#57606a;font-size:13px;">800 N King Street, Suite 304-1426, Wilmington, DE 19801, United States</p>
</div>
</body>
</html>",
  "preheader": "One word back from you: Yes, No or Not sure.",
  "subject": "A quick question about your healdesk agreement",
  "text": "Hi Radiance Med Spa team, when you signed up you told us your practice doesn't bill insurance electronically, so you signed our Data Protection Agreement. Your website mentions accepting insurance. That can be fine (superbills, or being out of network).

If your practice sends insurance claims or eligibility checks electronically, though, you need our business associate agreement instead.

Could you reply with one word: Yes, No or Not sure?

If it's Yes or Not sure, we'll send the business associate agreement to sign, and AYA pauses until it's signed. If it's No, nothing changes.

—
You're receiving this because this is the address on Radiance Med Spa's healdesk account.
Replies reach the healdesk team. Please leave out your clients' details.
800 N King Street, Suite 304-1426, Wilmington, DE 19801, United States
",
}
`;

