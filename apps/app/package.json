{
  "name": "@healdesk/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "TEST_APP_URL=postgres://healdesk_app:devapp@localhost:55432/healdesk_dev TEST_MIGRATOR_URL=postgres://healdesk_migrator:devmigrator@localhost:55432/healdesk_dev vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "queue:install": "tsx --env-file-if-exists=.env.local scripts/install-queue.ts",
    "db:readonly-grants": "tsx --env-file-if-exists=.env.local scripts/readonly-grants.ts",
    "db:writer-grants": "tsx --env-file-if-exists=.env.local scripts/writer-grants.ts",
    "email:seed": "tsx --env-file-if-exists=.env.local scripts/email-seed.ts",
    "worker": "tsx --env-file-if-exists=.env.local src/workers/index.ts",
    "voice": "tsx --env-file-if-exists=.env.local src/voice/server.ts",
    "patient-export": "tsx --env-file-if-exists=.env.local scripts/patient-export.ts",
    "destroy-due": "tsx --env-file-if-exists=.env.local scripts/destroy-due.ts",
    "reapply-erasures": "tsx --env-file-if-exists=.env.local scripts/reapply-erasures.ts",
    "ops:erase-person": "tsx --env-file-if-exists=.env.local scripts/ops-erase-person.ts",
    "ops:amend-record": "tsx --env-file-if-exists=.env.local scripts/ops-amend-record.ts",
    "ops:amend-contact": "tsx --env-file-if-exists=.env.local scripts/ops-amend-contact.ts",
    "ops:patient-request": "tsx --env-file-if-exists=.env.local scripts/ops-patient-request.ts",
    "ops:incident-affected": "tsx --env-file-if-exists=.env.local scripts/ops-incident-affected.ts",
    "qa:meta": "tsx --env-file-if-exists=.env.local scripts/meta-qa-gate.ts",
    "voice-eval": "tsx scripts/voice-eval/cli.ts",
    "voice-eval:scenarios": "tsx scripts/voice-eval/generate-scenarios.ts",
    "channels-link": "tsx --env-file-if-exists=.env.local scripts/channels-link.ts",
    "demo-clinic": "tsx --env-file-if-exists=.env.local scripts/demo-clinic.ts",
    "db:up": "bash scripts/dev-db.sh up",
    "db:down": "bash scripts/dev-db.sh down",
    "db:reset": "bash scripts/dev-db.sh reset",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-kms": "^3.1155.0",
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/client-sesv2": "^3.1155.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@healdesk/catalog": "*",
    "@healdesk/connectors": "*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^10.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "stripe": "^22.6.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.14.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
