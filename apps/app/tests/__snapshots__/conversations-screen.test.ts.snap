// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the O4 email for an export > clinic_export: what, when and which device; never whose, and every lint passes 1`] = `
{
  "html": "<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Your records were exported</title>
<style>@media (prefers-color-scheme: dark) {
  body, .hd-wrap { background: #0d1117 !important; color: #e6edf3 !important; }
  .hd-muted { color: #9da7b3 !important; }
  a { color: #8cc4ff !important; }
  a.hd-action { background: #e6edf3 !important; color: #0d1117 !important; }
}</style>
</head>
<body style="margin:0;padding:0;background:#ffffff;color:#1f2328;">
<span style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">They were downloaded at 10:32 am EDT on Monday 12 October, from “Front desk Mac”.</span>
<div class="hd-wrap" style="max-width:560px;margin:0 auto;padding:24px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#1f2328;background:#ffffff;">
<p style="margin:0 0 16px;">An export of all of Radiance Med Spa&#39;s records was downloaded from Conversations at 10:32 am EDT on Monday 12 October, from “Front desk Mac”.</p>
<p style="margin:0 0 16px;">Exports need Face ID or a screen lock on a device your clinic added, so this one came from a device on your sign-in.</p>
<p style="margin:16px 0 24px;"><a class="hd-action" href="https://app.healdesk.test/c/radiance-med-spa/settings#sign-in" style="display:inline-block;background:#1f2328;color:#ffffff;padding:10px 16px;border-radius:6px;text-decoration:none;font-weight:600;">See your devices</a></p>
<p style="margin:0 0 16px;">If that wasn&#39;t someone at your clinic, remove the device in Settings and reply to this email, and we&#39;ll check what happened.</p>
<hr style="border:none;border-top:1px solid #d0d7de;margin:24px 0 16px;">
<p class="hd-muted" style="margin:0 0 6px;color:#57606a;font-size:13px;">You&#39;re receiving this because this is the address on Radiance Med Spa&#39;s healdesk account.</p>
<p class="hd-muted" style="margin:0 0 6px;color:#57606a;font-size:13px;">Replies reach the healdesk team. Please leave out patient details.</p>
<p class="hd-muted" style="margin:0 0 6px;color:#57606a;font-size:13px;">800 N King Street, Suite 304-1426, Wilmington, DE 19801, United States</p>
</div>
</body>
</html>",
  "preheader": "They were downloaded at 10:32 am EDT on Monday 12 October, from “Front desk Mac”.",
  "subject": "Your records were exported",
  "text": "An export of all of Radiance Med Spa's records was downloaded from Conversations at 10:32 am EDT on Monday 12 October, from “Front desk Mac”.

Exports need Face ID or a screen lock on a device your clinic added, so this one came from a device on your sign-in.

See your devices: https://app.healdesk.test/c/radiance-med-spa/settings#sign-in

If that wasn't someone at your clinic, remove the device in Settings and reply to this email, and we'll check what happened.

—
You're receiving this because this is the address on Radiance Med Spa's healdesk account.
Replies reach the healdesk team. Please leave out patient details.
800 N King Street, Suite 304-1426, Wilmington, DE 19801, United States
",
}
`;

