exports[`the reminder once a channel is live > for clients: the snapshot 1`] = `
{
  "html": "<!doctype html>
<html lang="en" dir="ltr" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>One step left for AYA on your phone</title>
<!--[if mso]>
<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<style>td,th,div,p,a,h1,h2,span,li{font-family:'Segoe UI',Helvetica,Arial,sans-serif !important;}</style>
<![endif]-->
<style>
  :root { color-scheme: light dark; supported-color-schemes: light dark; }
  body { margin:0; padding:0; width:100%!important; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
  table { border-collapse:collapse; mso-table-lspace:0; mso-table-rspace:0; }
  img { border:0; line-height:100%; outline:none; text-decoration:none; }
  a[x-apple-data-detectors] { color:inherit!important; text-decoration:none!important; font:inherit!important; }
  u + #body a { color:inherit; text-decoration:none; font:inherit; }
  #MessageViewBody a { color:inherit; text-decoration:none; font:inherit; }
  .hd-action:hover { opacity:.88; }

  @media (max-width:620px) {
    .hd-wrap { width:100%!important; }
    .hd-px { padding-left:24px!important; padding-right:24px!important; }
    .hd-title { font-size:24px!important; line-height:30px!important; }
  }

  @media (prefers-color-scheme: dark) {
    body, .hd-page { background:#000000!important; }
    .hd-ink { color:#F5F5F7!important; }
    .hd-muted { color:#A1A1A6!important; }
    .hd-rule { border-color:#38383A!important; }
    .hd-soft { background:#1C1C1E!important; }
    .hd-link { color:#FF453A!important; }
    .hd-btn { background:#F5F5F7!important; }
    a.hd-action { background:#F5F5F7!important; color:#1D1D1F!important; }
    .hd-btn-outline { border-color:#F5F5F7!important; }
  }
  [data-ogsc] .hd-ink { color:#F5F5F7!important; }
  [data-ogsc] .hd-muted { color:#A1A1A6!important; }
  [data-ogsc] .hd-link { color:#FF453A!important; }
  [data-ogsc] a.hd-action { color:#1D1D1F!important; }
  [data-ogsc] .hd-btn-outline { border-color:#F5F5F7!important; }
  [data-ogsb] .hd-page { background:#000000!important; }
  [data-ogsb] .hd-soft { background:#1C1C1E!important; }
  [data-ogsb] .hd-btn, [data-ogsb] a.hd-action { background:#F5F5F7!important; }
</style>
</head>
<body id="body" class="hd-page" style="margin:0;padding:0;background:#FFFFFF;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#FFFFFF;opacity:0;">AYA is answering on your website chat. Here&#39;s what the rest needs.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="hd-page" style="background:#FFFFFF;">
<tr><td align="center" style="padding:0;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="hd-wrap" style="width:600px;max-width:600px;">
<tr><td align="center" class="hd-px" style="padding:48px 48px 0 48px;"><img src="https://healdesk.io/brand/healdesk-logo-email.png" width="176" height="32" alt="healdesk" style="display:block;margin:0 auto;width:176px;height:32px;border:0;outline:none;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:32px;font-weight:700;color:#E62627;text-align:center;"></td></tr>
<tr><td class="hd-px hd-ink" style="padding:40px 48px 0 48px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1D1D1F;">
<h1 class="hd-title hd-ink" style="margin:0 0 28px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:28px;line-height:34px;font-weight:700;letter-spacing:-0.5px;color:#1D1D1F;text-align:center;">One step left for AYA on your phone</h1>
<p class="hd-ink" style="margin:0 0 18px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:26px;color:#1D1D1F;">AYA is answering clients for Radiance Med Spa on your website chat. Phone isn&#39;t answering yet, and it needs one thing from you:</p>
<ul class="hd-ink" style="margin:0 0 18px;padding:0 0 0 22px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:26px;color:#1D1D1F;"><li style="margin:0 0 6px;">Phone: Set call forwarding on your main line</li></ul>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:10px auto 28px;border-collapse:separate;"><tr><td align="center" class="hd-btn" style="background:#1D1D1F;border-radius:980px;mso-padding-alt:14px 34px;"><a class="hd-action" href="https://app.healdesk.test/c/radiance-med-spa/setup?s=channels" style="display:inline-block;padding:14px 34px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:20px;font-weight:600;color:#FFFFFF;background:#1D1D1F;text-decoration:none;border-radius:980px;">Continue setup</a></td></tr></table>
<p class="hd-ink" style="margin:0 0 18px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:26px;color:#1D1D1F;">Call forwarding is easier with someone on the line. Book a five-minute call and we&#39;ll do it with you.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:4px auto 26px;border-collapse:separate;"><tr><td align="center" class="hd-btn-outline" style="border:1px solid #1D1D1F;border-radius:980px;mso-padding-alt:12px 30px;"><a class="hd-action-outline hd-ink" href="https://app.healdesk.test/help/call" style="display:inline-block;padding:12px 30px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:20px;font-weight:600;color:#1D1D1F;text-decoration:none;border-radius:980px;">Book a five-minute call</a></td></tr></table>
<p class="hd-ink" style="margin:0 0 18px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:26px;color:#1D1D1F;">Questions? Reply to this email, or write to hello@healdesk.io. Or leave a message on (888) 555-0100: we reply the next business day. Please don&#39;t include client details.</p>
</td></tr>
<tr><td class="hd-px" style="padding:40px 48px 48px 48px;">
<hr class="hd-rule" style="height:0;border:0;border-top:1px solid #D2D2D7;margin:0 0 24px 0;">
<p class="hd-muted" style="margin:0 0 10px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6E6E73;">You&#39;re receiving this because this is the address on Radiance Med Spa&#39;s healdesk account.</p>
<p class="hd-muted" style="margin:0 0 10px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6E6E73;">Replies reach the healdesk team. Please leave out your clients&#39; details.</p>
<p class="hd-muted" style="margin:0 0 10px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6E6E73;">800 N King Street, Suite 304-1426, Wilmington, DE 19801, United States</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>",
  "preheader": "AYA is answering on your website chat. Here's what the rest needs.",
  "subject": "One step left for AYA on your phone",
  "text": "AYA is answering clients for Radiance Med Spa on your website chat. Phone isn't answering yet, and it needs one thing from you:

- Phone: Set call forwarding on your main line

Continue setup: https://app.healdesk.test/c/radiance-med-spa/setup?s=channels

Call forwarding is easier with someone on the line. Book a five-minute call and we'll do it with you.

Book a five-minute call: https://app.healdesk.test/help/call

Questions? Reply to this email, or write to hello@healdesk.io. Or leave a message on (888) 555-0100: we reply the next business day. Please don't include client details.

—
You're receiving this because this is the address on Radiance Med Spa's healdesk account.
Replies reach the healdesk team. Please leave out your clients' details.
800 N King Street, Suite 304-1426, Wilmington, DE 19801, United States
",
}
`;

