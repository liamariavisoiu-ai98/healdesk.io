# Copy to .env — which is gitignored, and must stay that way.
#
# Node 24 loads this file natively via --env-file-if-exists in the npm script,
# so there is no dotenv dependency and no reason for a token to reach a shell
# profile, a committed script, or your terminal history.

# https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...

# Optional. Prefer `ant auth login`, which stores a short-lived OAuth profile
# the SDK finds on its own — no long-lived secret to store or rotate.
# ANTHROPIC_API_KEY=sk-ant-...
