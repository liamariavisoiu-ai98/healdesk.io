# =============================================================================
# healdesk — environment variables
# Copy to .env.local in the relevant app directory. Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# apps/web  (marketing site — NO PHI, safe on Vercel Hobby/Pro)
# -----------------------------------------------------------------------------

# Anthropic API key for the live chat demo, and for reading a clinic's public
# website at checkout (/api/clinic-site). Server-side only — never expose to
# the browser. Note the absence of NEXT_PUBLIC_: that prefix would ship it to
# the client, which is exactly the bug this route exists to fix.
ANTHROPIC_API_KEY=sk-ant-...

# The marketing site's data — demo leads, funnel events, the demo-call consent
# record and the site-wide daily spend counters — lives in a Google Sheet
# in the COMPANY Google account's Drive (never a personal one), read and
# written through a service account. apps/web has no database client at all;
# apps/app's Postgres is the PHI boundary and must never be reachable from
# here. Both variables are required together: with either missing the lead
# store fails open (the demo runs, the lead is logged as a count and lost),
# /admin/crm shows an empty state, and the daily caps in
# apps/web/src/lib/rate-limit.ts fall back to per-instance memory with one
# warning. Signing and checkout do NOT fail open: since 14 October 2026 the
# signed agreement and the purchase are recorded in this Sheet (its
# `agreements` and `checkout_intents` tabs, sealed with
# HEALDESK_PROVISION_SECRET; docs/design/checkout-records-on-vercel-2026-10-14.md),
# so without it /api/agreement and /api/checkout answer 503.
#
# MARKETING_SHEET_ID is the id of a blank Google Sheet created in the company
# Google account's Drive and shared as Editor with the service account
# healdesk-sheets@healdesk-marketing-2026.iam.gserviceaccount.com — the long
# token in the Sheet's URL between /d/ and /edit. Any blank Sheet works: the
# site provisions its tabs and their header rows on first use, or run
#   npm run sheets:init -w @healdesk/web
# once to do it up front and prove the sharing works.
MARKETING_SHEET_ID=

# The service account's key file, as one string: either the JSON exactly as
# `gcloud iam service-accounts keys create` wrote it, or base64 of that file
# (easier to paste into a secret store that dislikes newlines). A value that
# is not a usable key counts as unset. Never commit the file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# PostHog (US cloud — the client base is US) project key for funnel analytics.
# Safe to be public — it can only send events. Nothing initialises until the
# visitor accepts the cookie notice (apps/web/src/components/analytics).
# Inlined at BUILD time, so it must be in Vercel's Build environment and is
# declared in turbo.json's build.env. Unset = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=

# Vercel Cron authenticates its calls to /api/cron/* with this value as a
# Bearer token. Vercel generates it when a cron is deployed; copy it here so
# the routes can verify it. Without it every cron route answers 503.
# Two crons: purge-leads (daily) and nurture (hourly; daily on Hobby).
CRON_SECRET=

# Marketing email (the nurture sequence, the abandoned-checkout note, the
# contact form). Resend, because no patient information ever passes through
# apps/web and so no BAA is needed here. HEALDESK_EMAIL_FROM must be a real
# person at a SUBDOMAIN of healdesk.io that is NOT one of the cold-outreach
# domains — the two reputations must never mix. Verify the subdomain at
# resend.com and publish its SPF/DKIM/DMARC at Cloudflare first.
#   e.g. "Lia at healdesk <lia@mail.healdesk.io>"
# RESEND_WEBHOOK_SECRET is the "whsec_…" signing secret of a Resend webhook
# pointed at /api/webhooks/resend for email.bounced and email.complained;
# without it the route answers 503 and bounces are never recorded.
RESEND_WEBHOOK_SECRET=

# Demo spend ceilings, site-wide, per UTC day. The per-visitor limits are in
# the routes; these bound the bill. 0 switches the demo off.
DEMO_DAILY_CHAT_CAP=2000
DEMO_DAILY_CALL_CAP=40
# Browser calls from personalised demos (/demo/<slug>), which spend the same
# Retell minutes under their own ceiling.
DEMO_DAILY_WEBCALL_CAP=60

# Content-Security-Policy rollout. Both are read at BUILD time (Next writes
# headers() into the build), so set them in the Vercel project env and
# redeploy. CSP_REPORT_ONLY=1 emits Content-Security-Policy-Report-Only for
# the first week; delete it to enforce. CSP_REPORT_URI is optional.
CSP_REPORT_ONLY=
CSP_REPORT_URI=

# Signing secret for the demo's email-gate cookie. Required in production —
# the app throws at runtime rather than signing with a known dev string.
# Generate with: openssl rand -base64 32
#
# It now keys a second thing, and that one IS a security boundary. The
# checkout's agreement-download cookie (apps/web/src/lib/agreement-download.ts)
# is what proves a browser is the session that signed a BAA, and it is the only
# thing between an executed HIPAA contract and anyone who has the acceptance
# UUID. The two uses never share a key: that file signs with
# HMAC(this secret, purpose), so a gate cookie cannot be replayed as a download
# token. They do share this variable, so it now has two consequences the demo
# gate never had. Leaving it unset in production issues no download tokens at
# all, and every buyer silently gets the plain text copy instead of the PDF
# (deliberate: a missing PDF must never cost anyone their signature). Rotating
# it invalidates every outstanding download token immediately, which is also
# the only revocation this feature has.
HEALDESK_GATE_SECRET=

# Canonical site origin, used for metadata/OG/canonical URLs.
NEXT_PUBLIC_SITE_URL=https://healdesk.io

# The clinic portal's public origin (apps/app's BETTER_AUTH_URL), for the
# navbar's and the footer's "Sign in" link to its /sign-in. Inlined at build
# time, so it must be in Vercel's Build environment. Unset, no link is shown.
# Never the internal HEALDESK_APP_URL.
NEXT_PUBLIC_PORTAL_URL=

# Where the product lives: the internal origin, never shown to a browser. The
# Stripe webhook relays the first paid invoice, with the checkout records, to
# provisioning here, and /welcome asks here whether the account is ready,
# rather than connecting to the database itself, so exactly one service holds a
# connection to the database that will eventually contain PHI. Signing and
# paying do not call it (since 14 October 2026), so a buyer can pay while the
# AWS host is in standby. Its host also decides the parent domain the /welcome
# nonce cookie is set on, so apps/app's /welcome can read it.
HEALDESK_APP_URL=http://localhost:3001

# Shared with apps/app. The two run on different hosts (Vercel and AWS), so the
# provisioning call crosses a network boundary and is signed over the body and
# a timestamp. It also seals the checkout records kept in the marketing Sheet
# (under a key derived for that purpose alone), and apps/app refuses a record
# whose seal does not match, so it must be the same value on both apps, and
# rotating it makes every record not yet provisioned unopenable: rotate only
# with no purchase waiting on its first invoice. Without it, signing and
# checkout answer 503. Generate with: openssl rand -base64 32
HEALDESK_PROVISION_SECRET=

# Billing. Without STRIPE_SECRET_KEY, checkout provisions without payment in
# development and REFUSES to provision at all in production — see
# apps/web/src/lib/billing.ts.
#
# Create the products and prices once per Stripe environment:
#   STRIPE_SECRET_KEY=sk_test_... npx tsx apps/web/scripts/stripe-setup.ts
STRIPE_SECRET_KEY=

# Signing secret for POST /api/webhooks/stripe, which is where accounts are
# actually created. While this is unset the webhook returns 500 on purpose, so
# Stripe retries and no sale is lost while it is being configured.
#   Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Who may buy. Exactly "public" opens the purchase to everyone; unset or
# anything else means only a browser holding a setup link may sign and pay,
# and "Get started" opens "Tell us about your clinic" instead
# (apps/web/src/lib/checkout-mode.ts). Fail-closed on purpose: public waits for
# Google to verify the calendar app. Declared in turbo.json; after changing it,
# redeploy without the build cache and check the page.
HEALDESK_CHECKOUT_MODE=

# Whether /admin/setup may send setup links. Exactly "open" lets it; unset,
# production refuses. Set it only once the launch checklist (Gate A in
# docs/design/funnel-onboarding-portal-2026-10-06.md) is complete: a setup link
# promises the setup-fee-today purchase, and the checkout must honour that
# before any clinic is sent one. Outside production the flow is always open.
# The links are signed with HEALDESK_GATE_SECRET above, under their own purpose.
HEALDESK_SETUP_LINKS=

# The admin console at /admin. ONE account: no user store, no invitations, no
# team, no roles. The first three of these are required together — with any one
# missing the area is shut in every environment, development included, and the
# sign-in page says it is not set up rather than showing a form that cannot
# succeed — and the fourth, HEALDESK_ADMIN_TOTP_SECRET, is required for any
# sign-in to succeed. There is no development fallback anywhere in this path.
# Both factors are checked here, on Vercel: signing in makes no call to
# apps/app, so the console opens while the AWS host is off.

# The username, and the address every sign-in alert is sent to. apps/app needs
# the SAME value (see its section below): it writes this as the actor on every
# audit row the ops API produces, and nothing checks that the two agree.
HEALDESK_ADMIN_EMAIL=

# The password, stored only as a verifier. Format: scrypt$N$r$p$salt$key
# (N=16384, r=8, p=1, 64-byte key), generated by:
#   npx tsx apps/web/scripts/set-admin-password.ts
#
# ESCAPE EVERY DOLLAR SIGN AS \$ WHEN YOU PUT THIS IN A .env FILE. Next.js runs
# dotenv-expand over every value, and each `$N` in the format above reads as a
# variable reference: written literally, scrypt$16384$8$1$<salt>$<key> reaches
# the app as "scrypt6384==" and the sign-in page then says "Not configured."
# even though the file plainly contains a hash. Quoting does not help; only the
# backslash does. The script above escapes it for you. Hosting providers whose
# environment UI writes straight into the process (Vercel, Fly, Render) do not
# expand anything, so paste the RAW hash there and escape only in files.
#
# NEVER the password itself. That is the entire point of this being a hash: the
# plaintext belongs in a password manager and must not be written into this
# repository, a .env file, a shell history or a hosting provider's environment
# UI. There is no HEALDESK_ADMIN_PASSWORD any more, and nothing reads one.
HEALDESK_ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Unlike HEALDESK_GATE_SECRET above there is no
# development fallback — an admin session is never signed with a string that is
# in the source. Rotating this invalidates every outstanding admin session,
# which is the only revocation this app has.
# Generate with: openssl rand -base64 32
HEALDESK_ADMIN_SECRET=

# The second factor: the authenticator app's TOTP secret, 32 characters of
# unpadded base32 (20 random bytes; RFC 6238, SHA-1, 6 digits, 30 seconds).
# Made by `npm run admin:totp -w @healdesk/web`, which shows a QR code, checks
# a code from your phone, and only then prints the value. It writes it nowhere:
# add it in Vercel as a Sensitive variable on Production
# (vercel env add HEALDESK_ADMIN_TOTP_SECRET production --sensitive), and put
# it in apps/web/.env.local yourself only if you sign in locally. Unset or
# malformed, a correct password is answered 503 naming this variable and
# nobody is signed in on the password alone. There are no recovery codes: a
# lost phone means running the script again and replacing the value, and the
# Vercel account's own second factor is the way back in. Until 14 October 2026
# this secret lived in apps/app's database (admin_totp, dropped by 0074).
HEALDESK_ADMIN_TOTP_SECRET=

# Read-only GitHub token for the admin view's change feed. Without it the view
# falls back to reading the local checkout with git log, which only works in
# development: a deployed instance has no repository on disk, so the feed comes
# back empty and says so rather than showing a stale one. A public repo needs a
# token with no scopes; a private one needs repo. The page shows which source it
# read, so which of the two you got is never a guess.
GITHUB_TOKEN=

# Which repository that token reads, as owner/name. Unset means
# liamariavisoiu-ai98/healdesk.io. Only consulted when GITHUB_TOKEN is set — the
# local fallback reads whatever checkout it is running inside.
HEALDESK_REPO=

# The AWS host's switch at /admin/host (infra/aws README, "Standby"): it
# dispatches .github/workflows/host.yml (turn on, or standby) and reads its
# runs, and the Stripe webhook dispatches it too when a first paid invoice
# finds the host in standby (lib/host/wake.ts). A fine-grained personal access
# token OF THE REPOSITORY'S OWNER, scoped to this repository only, with
# "Actions: read and write" and nothing else: the runs it starts carry the
# owner's id, which the AWS roles require, so anyone else's token starts runs
# AWS refuses. It can start and cancel any workflow here, so it lives on
# Vercel (Production) and nowhere else, never in a browser. Unset, /admin/host
# says what to set and the webhook wakes nothing. Runtime only.
HEALDESK_GITHUB_ACTIONS_TOKEN=

# The repository host.yml lives in, as owner/name. Unset means
# liamariavisoiu-ai98/healdesk.io.
HEALDESK_GITHUB_REPO=

# The "have AYA call me" demo call — Retell.
#
# READ ONLY BY apps/web. Set them on the marketing site's project, not the PHI
# host. The demo call is placed for a CLINIC OWNER evaluating the product; the
# product's own voice agent is a different Retell agent, configured in apps/app.
#
# Without the first three, apps/web/src/app/api/callback/route.ts logs which is
# missing and returns a 503; there is deliberately no email fallback, because
# the phone field IS the demo.
#
# The Retell API key (Settings -> API Keys), sent as `Authorization: Bearer`.
# Also what scripts/retell-demo-agent.ts uses to push the agent.
RETELL_API_KEY=

# AYA's demo agent, printed by `npm run retell:demo -w @healdesk/web` the first
# time it runs. Re-running the script with this set updates that agent in place.
RETELL_DEMO_AGENT_ID=

# The caller ID, E.164: a number bought in Retell (Phone Numbers). A
# Retell-bought number can only dial US numbers.
RETELL_DEMO_FROM_NUMBER=

# The Retell API key that carries the webhook badge. It signs every request
# the demo agent's request_follow_up tool sends to /api/voice-demo/follow-up;
# unset, that route refuses and AYA gives out the inbox address instead.
RETELL_WEBHOOK_KEY=

# The personalised clinic demo's agent (one agent for every demo; the clinic
# arrives per call as dynamic variables), printed by
# `npm run retell:clinic-demo -w @healdesk/web` the first time it runs.
# Used by the browser call (/api/demo/<slug>/retell/...) and by "call me" on a
# /demo page (api/callback with a demoSlug, which also needs the from number).
RETELL_CLINIC_DEMO_AGENT_ID=

# -----------------------------------------------------------------------------
# Personalised demos (apps/web, /admin/demos and /demo/<slug>)
# -----------------------------------------------------------------------------
# Built from a prospect's public website after they ask for one. Also needs
# ANTHROPIC_API_KEY (reads the site into a profile and runs the chat), the
# marketing Sheet (MARKETING_SHEET_ID + GOOGLE_SERVICE_ACCOUNT_JSON; rows go in
# its demo_sessions tab), and RESEND_* to email the link. APIFY_TOKEN (below,
# shared with packages/leadgen) is optional on apps/web: set, sites built in
# the browser (Wix, Squarespace, React themes) are read with a real browser;
# unset, only their server-rendered HTML is read.
#
# Bearer secret for POST /api/demo-sessions, the automation webhook (Instantly
# reply rule, Zapier, n8n). At least 24 characters; unset, the webhook is off.
DEMO_WEBHOOK_SECRET=
# Optional Slack incoming-webhook URL (https://hooks.slack.com/...) for
# "demo claimed" alerts and the handoff audit's "held for review" and
# "shipped with a flag" alerts. Unset, they go to the server log only, and a
# held demo is seen only on /admin/demos.
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# apps/app  (product — HANDLES PHI, requires BAA-covered infrastructure)
# -----------------------------------------------------------------------------
# Do not point these at production data until a BAA is in place with every
# processor in the path. See docs/hipaa-compliance.md.
#
# For local development: `npm run db:up -w @healdesk/app` starts Postgres in
# Docker, provisions both roles, migrates, and prints these values.

# TWO roles, deliberately. The runtime role must NOT have BYPASSRLS and must not
# own the tables — a table's owner bypasses its own row-level security policies
# unless FORCEd, and the owner role a managed Postgres vendor hands out
# (Supabase's service_role, for one) bypasses RLS outright.
# tests/tenant-isolation.test.ts asserts this.
DATABASE_URL=postgresql://healdesk_app:pass@host:5432/healdesk

# Owns the schema. Used by migrations and clinic provisioning only.
MIGRATION_DATABASE_URL=postgresql://healdesk_migrator:pass@host:5432/healdesk

# Isolation tests. Unset means the database-backed suites skip rather than fail.
TEST_APP_URL=
TEST_MIGRATOR_URL=

# Session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Credential vault key wrapping.
#   local   — KEK from HEALDESK_LOCAL_KEK. Development only; refused in production.
#   aws-kms — KMS holds the key and never releases it; every unwrap is a
#             CloudTrail event. @aws-sdk/client-kms ships with apps/app.
#             HEALDESK_KMS_KEY_ID is then the key's full ARN,
#             arn:aws:kms:us-east-1:<12-digit account>:key/<key id>, as
#             `aws kms describe-key` prints it. An alias, a bare key id, a
#             multi-Region key or a key in another region is refused, and so is
#             an AWS_REGION other than us-east-1 (see AWS_REGION below): no
#             credential can then be sealed or opened. The worker seals and
#             opens a throwaway value once at start and logs whether it worked
#             ("credential key self-check passed", or FAILED with a one-word
#             code): that line is how to confirm the key. The read-only ops
#             operation getCredentialKeyStatus asks the web tier the same on
#             demand, and /admin/map shows its answer on the key-safe bridge.
HEALDESK_KMS_PROVIDER=local
HEALDESK_KMS_KEY_ID=
# 32 bytes, base64. Generate with: openssl rand -base64 32
HEALDESK_LOCAL_KEK=

# The key of the HMAC that stands in for a vendor's identifier (a WhatsApp
# sender, which is a phone number; a Meta message id; a call id) in
# chat_threads, meta_inbound_messages and usage_events (lib/identifier-ref.ts).
# Required in production, at least 32 characters; outside production a fixed
# development key is used when it is unset. NEVER rotate it without a re-key
# plan: every stored reference was made under it, so a new key splits
# conversations, re-admits redelivered messages and counts calls twice.
# Generate with: openssl rand -base64 32
HEALDESK_IDENTIFIER_REF_KEY=

# Must match apps/web's value — this verifies what checkout signs, and
# authenticates the admin console's every read and action over /api/ops.
HEALDESK_PROVISION_SECRET=

# The one administrator, and it MUST be the same address as apps/web's
# HEALDESK_ADMIN_EMAIL above. This app never checks a password or a code: it
# takes the identity from this variable and writes it as the actor on every
# audit row the ops API produces. (The sign-in alert is apps/web's since
# 14 October 2026, sent to apps/web's own HEALDESK_ADMIN_EMAIL.) Unset, /api/ops
# answers 503 to everything rather than writing rows that look attributed and
# are not.
HEALDESK_ADMIN_EMAIL=

# Background worker (pg-boss). No separate URL: the queue lives in the same
# Postgres, so it uses DATABASE_URL as the runtime role.
#
# Install the queue schema ONCE per environment, as the migrator, before the
# worker will start — the runtime role deliberately cannot CREATE:
#   npm run queue:install -w @healdesk/app
#   npm run worker        -w @healdesk/app
#
# Only needed if the runtime role isn't called healdesk_app.
HEALDESK_RUNTIME_ROLE=healdesk_app

# Email delivery. Which of the two transports carries the mail — and, for one of
# them, which mail it is allowed to carry.
#
#   unset   — nothing is sent. The console transport logs the message and
#             reports honestly that it was skipped. Development only: in
#             production getTransport() throws rather than mailing nobody
#             quietly, because a scheduler logging "sent 40 reports" while
#             sending none looks like success for a month.
#   resend  — the working transport today. Needs RESEND_API_KEY and
#             HEALDESK_EMAIL_FROM below, plus a domain verified at resend.com;
#             no AWS account, no DKIM round trip, no production-access review.
#             Carries ONLY messages declared phiClass "none" — which is all four
#             of today's messages — and REFUSES anything else outright rather
#             than downgrading. Resend states it is not HIPAA compliant and
#             signs no business associate agreement, and it has no equivalent of
#             the TLS enforcement below, so there is no way to make a
#             PHI-bearing message fail closed on it.
#   ses     — the only setting allowed to carry patient information, because a
#             configuration set can be made to REQUIRE TLS and the app reads
#             that back before it will send. Needs HEALDESK_EMAIL_FROM and the
#             two SES variables below. @aws-sdk/client-sesv2 is a dependency of
#             apps/app and ships in the image; nothing to install.
#
# The email platform (lib/email/send.ts: every outbox notice and every ops
# alert) sends only with "resend". Unset, it uses the console stub, which is
# refused in production; "ses" is the PHI path, which the platform never uses,
# so production needs "resend" for any clinic email to go.
#
# This carries the monthly report and the clinic's connect link (both phase two,
# not sent in v1), the teammate invitation — and the signed business associate
# agreement, which is the one with legal
# weight. A signer whose copy does not go out cannot produce the contract they
# signed; the ops console counts those ("N signers have no copy on file") and
# offers a resend, so a misconfiguration here is visible rather than silent, but
# it is still a contract only one party holds.
# Where the watchdog's digest and other operator-only mail go. Falls back to
# HEALDESK_ADMIN_EMAIL. Never a clinic's address.
HEALDESK_OPS_EMAIL=

# Help, as the setup wizard, the clinic's page and the setup emails offer it
# (apps/app/src/lib/setup/help.ts). Both are the owner's and public, read from
# here only and never written into code. Each line is hidden while its
# variable is unset or malformed, so nothing dead is ever shown.
#
# The support voicemail line, E.164. Its provider must email a notification
# only (caller and time, no recording or transcript: the plan's open item 7);
# Help asks callers to leave out patient details.
HEALDESK_SUPPORT_PHONE=+18886889404
# The five-minute call clinics book to set up call forwarding with us, an https
# scheduling page. Emails link it through /help/call on this app, which reads
# it at click time, so an old email still reaches today's page.
HEALDESK_CALL_BOOKING_URL=https://calendly.com/healdesk-io/quick-onboarding

# Healdesk's own test phones (apps/app/src/lib/voice/test-numbers.ts): the
# numbers an operator rings a clinic's line from to hear AYA, during the
# forwarding test or after go-live. A call from one is never billed as minutes
# and is never phone's first answer, the day a clinic's plan or a channel's
# price starts. Comma-separated, in any shape (kept as E.164); empty by
# default, so every call counts until a number is listed.
HEALDESK_TEST_NUMBERS=

# The Retell API key of the workspace under Retell's BAA (never the marketing
# site's RETELL_API_KEY above, a different workspace). The worker keeps each
# clinic's AYA number's fallback on the clinic's direct line with it, hourly,
# so Retell's outage mode sends every call to a person while our endpoint is
# down; the voice endpoint reads that fallback back when it cannot read the
# database (apps/app/src/lib/voice/retell-fallback-sync.ts, fallback-line.ts).
# Unset, the sync does nothing and a call that cannot read the database
# reaches the direct line only if this process remembers it.
HEALDESK_RETELL_API_KEY=

# The live-booking kill switch (owner decision 4, 5 October 2026). Anything but
# the literal "true" means the assistant never books a caller itself and every
# booking is a request for the clinic's staff to confirm. It gates only the
# assistant's own bookings, never a staff confirmation's write to Google, and
# it is read on every call. Only the healdesk owner sets it, per environment:
# no commit, script, CI file, Dockerfile, deploy step or this file does.
# Leave it empty here.
HEALDESK_DIRECT_BOOKING_ENABLED=

# healdesk's Google OAuth client for the clinic's Google Calendar connection
# (one Web client per Google Cloud project; its redirect URI is
# <BETTER_AUTH_URL>/api/calendar/google/callback). apps/app only: set them in
# the AWS BAA host's secret store for apps/app, never on apps/web and never
# on any Vercel project. Unset, nobody is sent to Google: the calendar page
# says connection isn't available yet and no calendar link is minted.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Phase two: attribution. The monthly revenue report, the nightly
# booking-system sync and reconciliation, and the read-back connect link
# (/connect/<token>) are fenced out of v1: their code is kept, but none of it
# runs, and the ops console refuses to switch those jobs on, unless this is
# exactly "true". Leave it UNSET in every v1 environment: v1 may not claim
# revenue, collected money or recovered revenue (docs/v1-product-spec.md).
HEALDESK_PHASE_TWO_ATTRIBUTION=

# The call-back dialer's switch (HEALDESK_OUTBOUND_CALLBACKS_ENABLED) and the
# WhatsApp template switch (HEALDESK_WHATSAPP_TEMPLATES_ENABLED) were removed:
# v1 is inbound only. So were the old voice webhook's and mid-call tools'
# bearers (HEALDESK_VOICE_WEBHOOK_SECRET, HEALDESK_VOICE_TOOLS_SECRET, 14
# October 2026): voice is the Retell endpoint, behind HEALDESK_RETELL_LLM_SECRET.
# Delete them from any environment that still sets them.

HEALDESK_EMAIL_TRANSPORT=

# Resend API key, for HEALDESK_EMAIL_TRANSPORT=resend. Scope it to sending on
# the verified domain. Unset, ResendTransport throws on the first send naming
# this variable — deliberately not the warn-and-continue fallback in lib/env.ts,
# which would hand Resend an empty key and turn one configuration error into a
# 401 per message.
#   https://resend.com/api-keys
# Read by BOTH apps: apps/app's transport layer and apps/web's contact and
# review forms, which post to Resend directly.
RESEND_API_KEY=

# The From address, on a domain verified with whichever transport is configured.
# Required by BOTH: SesTransport and ResendTransport each throw, naming it, if
# it is unset. Printable US-ASCII — the SES path writes it into the From header
# verbatim. "healdesk <hello@healdesk.io>" is fine.
HEALDESK_EMAIL_FROM=

# The SES configuration set, which must have TlsPolicy=REQUIRE. Not optional:
# SesTransport refuses to send without one, because SES defaults to
# OPPORTUNISTIC TLS and delivers in cleartext to any server that declines to
# negotiate — which the BAA promises we will not do. The app reads the policy
# back from the API on the first send and refuses if it is anything else, so a
# set that exists but was never configured fails loudly.
#   aws sesv2 put-configuration-set-delivery-options \
#     --configuration-set-name healdesk-phi --tls-policy REQUIRE
HEALDESK_SES_CONFIGURATION_SET=

# Region for both AWS clients, SES and KMS. Unset or empty means us-east-1, the
# region designated under the AWS business associate agreement, and in any
# deployment with HEALDESK_KMS_PROVIDER=aws-kms that is the only value allowed:
# the key is in us-east-1, so getKeyWrapper() refuses any other region and no
# credential can be sealed or opened. Leave it unset or set it to us-east-1, and
# verify the SES sending domain and create the configuration set in us-east-1
# too: SES identities and configuration sets are regional, so ones made
# elsewhere fail each send with an SES error. Ignored by the Resend transport,
# which has no regional endpoint.
AWS_REGION=

# Telephony / voice. Twilio signs BAAs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The Meta front door (Messenger, Instagram DMs, WhatsApp): the narrow,
# PHI-free agent that answers public questions and hands off to phone or web.
# META_APP_SECRET verifies X-Hub-Signature-256 on POST /api/webhooks/meta;
# META_VERIFY_TOKEN answers the one-time GET verification when the webhook is
# registered in the Meta app. Page and WhatsApp access tokens are NOT here:
# they are sealed per clinic in provider_connections from the ops console.
# Unset, the route answers 503 and sends nothing.
META_APP_SECRET=
META_VERIFY_TOKEN=

# The PATIENT-DATA Anthropic organisation's key (the one with the BAA), for
# the Meta front door's replies. Never the marketing org's key, and never
# with web search enabled. Unset, the front door answers with the fixed
# hand-off line only and never calls a model.
ANTHROPIC_API_KEY=

# Speech. Deepgram signs BAAs.
DEEPGRAM_API_KEY=

# Payments / deposits. STRIPE_SECRET_KEY is the platform's key; deposits go
# into the clinic's own Stripe through Connect (Standard accounts).
# STRIPE_CONNECT_CLIENT_ID (ca_…) is on the Connect settings page once the
# platform is enabled; until it is set no Connect link can be minted, so
# deposits cannot be switched on. The callback Stripe returns to is
# <BETTER_AUTH_URL>/api/connect/stripe — register it there, in both modes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Signing secret of the Connect webhook endpoint (connect: true) at
# <BETTER_AUTH_URL>/api/webhooks/stripe-connect: deposit payments and
# revocations on clinics' own accounts. Its own secret, never apps/web's
# STRIPE_WEBHOOK_SECRET, so a leaked platform secret cannot forge "deposit
# paid". Unset, the endpoint answers 503 and records nothing.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Where the ops console lives, for redirects back from a vendor (Stripe
# Connect). The marketing site's origin; defaults to https://healdesk.io.
HEALDESK_WEB_URL=

# -----------------------------------------------------------------------------
# packages/leadgen  (prospecting pipeline — run locally or in a job runner)
# -----------------------------------------------------------------------------
# Also read by apps/web's personalised demo builder (see above), if set there.
APIFY_TOKEN=

# -----------------------------------------------------------------------------
# scripts/outreach  (cold-email sending infrastructure)
# See docs/outreach/coldemail-infra-runbook.md. Never commit real values; these
# are read from the environment and must never be echoed into the run log.
# -----------------------------------------------------------------------------

# Cloudflare, scoped token ONLY — Zone.DNS:Edit + Zone.Zone:Read limited to the
# 10 cold-sending zones. Never the Global API Key: that key is account-wide and
# cannot be scoped, so leaking it hands over every zone including healdesk.io.
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (Dashboard > any zone > Overview > right sidebar).
CLOUDFLARE_ACCOUNT_ID=

# InboxKit — mailbox provisioning and the isolated-network warmup pool.
# Generated in app.inboxkit.com > Settings > API.
INBOXKIT_API_KEY=

# Independent seed-placement testing. This is the go/no-go gate for live
# sending; a vendor's own warmup dashboard does not substitute for it.
GLOCKAPPS_API_KEY=
MAILREACH_API_KEY=

# Instantly — sequencing/sending only. Instantly's own warmup stays OFF.
INSTANTLY_API_KEY=
