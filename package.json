{
  "name": "healdesk",
  "private": true,
  "version": "0.1.0",
  "description": "Vertical AI front-desk / voice-agent service for high-ticket elective healthcare",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@healdesk/web",
    "dev:app": "turbo run dev --filter=@healdesk/app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs": "node scripts/docs-site/serve.mjs",
    "docs:build": "node scripts/docs-site/build.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.7.2"
  }
}
