{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Turborepo hides environment variables from tasks unless declared, and
      // hashes them into the cache key. Undeclared vars are not just missing —
      // a build would also be cached as if they never mattered.
      "env": [
        "DATABASE_URL",
        "MIGRATION_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "HEALDESK_KMS_PROVIDER",
        "HEALDESK_KMS_KEY_ID",
        "HEALDESK_LOCAL_KEK",
        "ANTHROPIC_API_KEY",
        "HEALDESK_GATE_SECRET",
        "NEXT_PUBLIC_SITE_URL",
        "HEALDESK_APP_URL",
        "HEALDESK_PROVISION_SECRET",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "HEALDESK_EMAIL_TRANSPORT",
        // The PostHog project key is inlined into the client bundle at build
        // time; missing here, the site builds with analytics silently off.
        "NEXT_PUBLIC_POSTHOG_KEY",

        // Everything below is read at RUNTIME only — no NEXT_PUBLIC_ prefix, so
        // none of it is inlined into a bundle and none of it changes build
        // output. They are declared anyway, for the reason above: turbo 2.x
        // defaults to strict env mode, so an undeclared var is invisible to the
        // task, and the first one that ever moves to build time would fail
        // silently rather than loudly. The cost is that rotating one of these
        // secrets invalidates the build cache, which is the safe direction to
        // be wrong in.

        // The admin console. The first three are required together; with any
        // one missing the area is shut in every environment. The TOTP secret
        // is the second factor, checked on Vercel: without it no sign-in
        // succeeds.
        "HEALDESK_ADMIN_EMAIL",
        "HEALDESK_ADMIN_PASSWORD_HASH",
        "HEALDESK_ADMIN_SECRET",
        "HEALDESK_ADMIN_TOTP_SECRET",

        // The admin change feed. Without a token it falls back to reading the
        // local checkout with git log, which a deployed instance does not have.
        "GITHUB_TOKEN",
        "HEALDESK_REPO",

        // The marketing Sheet: leads, funnel events, call consents and the two
        // daily spend counters. Required together; either missing fails open.
        "MARKETING_SHEET_ID",
        "GOOGLE_SERVICE_ACCOUNT_JSON",

        // Mail. RESEND_API_KEY and HEALDESK_EMAIL_FROM are checked as one
        // condition, so either missing takes out both the contact form and the
        // leave-a-review form.
        "RESEND_API_KEY",
        "HEALDESK_EMAIL_FROM",
        "HEALDESK_SES_CONFIGURATION_SET",
        "AWS_REGION",
        // The transcript outbox (13 October 2026): the SNS topic whose signed
        // SES events /api/webhooks/ses trusts.
        "HEALDESK_SES_EVENTS_TOPIC_ARN",
        // The web chat and the Retell voice endpoint (13 October 2026): the
        // models each uses, and the secret in each clinic's custom-LLM URL.
        "HEALDESK_CHAT_MODEL",
        "HEALDESK_VOICE_MODEL",
        "HEALDESK_RETELL_LLM_SECRET",

        // The "have AYA call me" demo, on Retell. The first three are required
        // for a call to be placed at all. The webhook key signs the agent's
        // request_follow_up tool calls; unset, that tool refuses and AYA gives
        // out the inbox address instead.
        "RETELL_API_KEY",
        "RETELL_DEMO_AGENT_ID",
        "RETELL_DEMO_FROM_NUMBER",
        "RETELL_WEBHOOK_KEY",

        // apps/app, Phases 6 and 8. The watchdog's digest address, the voice
        // webhook's bearer, the Meta webhook's secret and verify token, Stripe
        // Connect's platform id, and where the console lives for redirects.
        "HEALDESK_OPS_EMAIL",
        "HEALDESK_VOICE_WEBHOOK_SECRET",
        // The booking design of 23 September 2026: the direct-booking switch
        // (off unless "true") and the mid-call tool routes' own bearer. The
        // call-back and WhatsApp-template switches went with v1's
        // inbound-only rule.
        "HEALDESK_DIRECT_BOOKING_ENABLED",
        "HEALDESK_VOICE_TOOLS_SECRET",
        // The Google Calendar connection (plan §12): apps/app only; set on the
        // AWS BAA host, never on a Vercel project.
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        // Phase two (attribution): off unless "true", and unset in v1.
        "HEALDESK_PHASE_TWO_ATTRIBUTION",
        "META_APP_ID",
        "META_APP_SECRET",
        "META_VERIFY_TOKEN",
        "META_LOGIN_CONFIG_ID",
        "META_WHATSAPP_CONFIG_ID",
        "STRIPE_CONNECT_CLIENT_ID",
        // The Stripe launch (5 October 2026): the Connect webhook's own
        // signing secret on apps/app, and apps/web's switch for Stripe Tax on
        // Checkout (on only when "true").
        "STRIPE_CONNECT_WEBHOOK_SECRET",
        "STRIPE_AUTOMATIC_TAX",
        // The Stripe build (6 October 2026): the key of the HMAC that stands
        // in for a vendor's identifier in apps/app's ledgers.
        "HEALDESK_IDENTIFIER_REF_KEY",
        // The funnel (6 October 2026): who may buy ("public", or by setup
        // link when unset or anything else) and whether /admin may send setup
        // links yet ("open" once the launch checklist is done). Declared so a
        // flip changes the cache key and a cached build never serves the old
        // gate.
        "HEALDESK_CHECKOUT_MODE",
        "HEALDESK_SETUP_LINKS"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_APP_URL", "TEST_MIGRATOR_URL", "HEALDESK_LOCAL_KEK"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
