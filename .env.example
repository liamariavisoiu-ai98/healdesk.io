# =============================================================================
# healdesk — environment variables
# Copy to .env.local in the relevant app directory. Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# apps/web  (marketing site — NO PHI, safe on Vercel Hobby/Pro)
# -----------------------------------------------------------------------------

# Anthropic API key for the live chat demo. Server-side only — never expose to
# the browser. Note the absence of NEXT_PUBLIC_: that prefix would ship it to
# the client, which is exactly the bug this route exists to fix.
ANTHROPIC_API_KEY=sk-ant-...

# Signing secret for the demo's email-gate cookie. Required in production —
# the app throws at runtime rather than signing with a known dev string.
# Generate with: openssl rand -base64 32
HEALDESK_GATE_SECRET=

# Upstash Redis — distributed rate limiting for the gated chat.
# Optional: without it the app falls back to an in-memory limiter, which is
# per-instance and therefore leaky across serverless cold starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site origin, used for metadata/OG/canonical URLs.
NEXT_PUBLIC_SITE_URL=https://healdesk.io

# -----------------------------------------------------------------------------
# apps/app  (product — HANDLES PHI, requires BAA-covered infrastructure)
# -----------------------------------------------------------------------------
# Do not point these at production data until a BAA is in place with every
# processor in the path. See docs/hipaa-compliance.md.

# Postgres. Supabase (Team plan+) and Neon (Business plan+) both sign BAAs.
DATABASE_URL=postgresql://user:pass@host:5432/healdesk

# Telephony / voice. Twilio signs BAAs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Voice orchestration (managed layer while validating demand).
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# Speech. Deepgram signs BAAs.
DEEPGRAM_API_KEY=

# Payments / deposits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# packages/leadgen  (prospecting pipeline — run locally or in a job runner)
# -----------------------------------------------------------------------------
APIFY_TOKEN=
