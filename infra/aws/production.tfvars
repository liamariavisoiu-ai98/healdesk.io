# Production values for infra/aws (terraform plan -var-file=production.tfvars).
#
# Nothing here is a secret. Secrets are either generated by Terraform into SSM
# Parameter Store or pasted there by the owner (the parameters_to_fill output
# lists which). The reasons behind each value are in variables.tf.

environment = "production"
region      = "us-east-1"
app_domain  = "app.healdesk.io"

# FILL IN before the first plan; the plan refuses to run while these are empty.
#
# cloudflare_zone_id: Cloudflare dashboard, healdesk.io, Overview, API section,
#   "Zone ID" (32 hex characters). Not a secret.
# alarm_email: receives alarms and budget alerts; confirm the SNS email once.
# healdesk_admin_email: the /admin operator address, byte-for-byte the
#   HEALDESK_ADMIN_EMAIL already set on Vercel (nothing checks they match).
cloudflare_zone_id   = ""
alarm_email          = ""
healdesk_admin_email = ""

# Optional: where ops alerts go. Empty falls back to healdesk_admin_email.
healdesk_ops_email = ""

healdesk_email_from = "healdesk <hello@healdesk.io>"

# Network: one NAT gateway (2 for resilience), no VPC endpoints, no flow logs.
nat_gateways     = 1
vpc_endpoints    = false
enable_flow_logs = false

# Load balancer and tasks.
alb_to_task_tls    = true
alb_idle_timeout   = 120
enable_waf         = true
waf_rate_limit     = 2000
container_insights = false
web_desired        = 1
worker_desired     = 1

# Database.
postgres_version     = "17.11"
db_instance_class    = "db.t4g.small"
db_allocated_storage = 20
db_multi_az          = false

# Public ids for the web tier. Empty keeps the matching feature off; fill them
# in when the Meta app and Stripe Connect are configured for this host.
meta_app_id              = ""
meta_login_config_id     = ""
meta_whatsapp_config_id  = ""
stripe_connect_client_id = ""

# Monitoring and cost.
enable_guardduty   = true
monthly_budget_usd = 250

# GitHub's immutable OIDC subject for this repository's production environment,
# in both capitalisations, exactly as the bootstrap stack's Terraform role.
github_oidc_subjects = [
  "repo:liamariavisoiu-ai98@262780224/healdesk.io@1326499636:environment:production",
  "repo:liamariavisoiu-ai98@262780224/healdesk.io@1326499636:environment:Production",
]
